# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Control Tower live tracking — ShipsGo API user token (SECRET).
# NOT a Vite var — set it in the Cloudflare Pages dashboard
# (Settings -> Environment variables) so functions/api/track.ts can reach
# ShipsGo. The browser never sees it.
# SHIPSGO_TOKEN=your-shipsgo-user-token

# ShipsGo *embed* token for the live-map iframe (public — this is the same
# token already on expac.co.za/live-tracking). Optional; falls back to the
# built-in default. This one IS a Vite var (shipped to the browser).
# VITE_SHIPSGO_EMBED_TOKEN=your-shipsgo-embed-token

# ---------------------------------------------------------------------------
# Custom CDN domain for email images (Media gallery + template/campaign
# bodies). When set, src/lib/db.ts routes public `mail-assets` URLs through
# this host instead of the raw <project>.supabase.co URL, so inline <img>
# src values align with the sending domain (expac.co.za) and stop tripping
# Outlook/SmartScreen's phishing heuristic. Point it at the Cloudflare Pages
# proxy (functions/mail-assets/[[path]].ts) served on a custom domain.
# IS a Vite var (baked into the browser bundle). Leave unset until the
# cdn.expac.co.za custom domain + DNS are live — URLs fall back to Supabase.
# VITE_MAIL_CDN_BASE=https://cdn.expac.co.za/mail-assets
#
# functions/mail-assets/[[path]].ts reuses SUPABASE_URL (already set below)
# to know which Supabase project to proxy — no extra server var needed.

# ---------------------------------------------------------------------------
# Shipment Comms — customer emails via Resend. ALL set in the Cloudflare Pages
# dashboard (Settings -> Environment variables), NOT here. functions/api/*.
#
# functions/api/send-mail.ts:
#   RESEND_API_KEY        re_...            (secret)
#   MAIL_FROM             EXPAC Forwarding <support@expac.co.za>
#   MAIL_REPLY_TO         support@expac.co.za
#   SUPABASE_URL          https://YOUR-PROJECT-ref.supabase.co   (verifies the caller)
#   SUPABASE_ANON_KEY     your-anon-public-key
#
# functions/api/mail-webhook.ts (delivery status + inbound replies):
#   RESEND_WEBHOOK_SECRET       whsec_...   (from the Resend webhook)
#   SUPABASE_SERVICE_ROLE_KEY   service-role key (secret — used only in this function)
#
# Follow-up workflows (Phase 5) — the pg_cron job calls send-mail with this
# instead of a user JWT. Must match private.follow_up_config.cron_secret in the DB.
#   CRON_SECRET                 a long random string
#
# DNS: add Resend's DKIM/SPF/DMARC records for expac.co.za. For inbound
# replies, add Resend's inbound MX record and point the webhook at
# https://expac-motion.pages.dev/api/mail-webhook

# ---------------------------------------------------------------------------
# AI rewrite (Templates / Campaigns editor "AI" button) — Anthropic Messages
# API. Set in the Cloudflare Pages dashboard, NOT here. functions/api/ai-rewrite.ts
# reuses SUPABASE_URL / SUPABASE_ANON_KEY (above) to verify the caller.
#   ANTHROPIC_API_KEY    sk-ant-...   (secret — from console.anthropic.com)
