# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Live Tracking (Operations Control Tower). NOT a Vite var — set it in the
# Cloudflare Pages dashboard (Settings -> Environment variables) so the
# functions/api/track.ts proxy can reach ShipsGo. The browser never sees it.
# SHIPSGO_TOKEN=your-shipsgo-user-token
